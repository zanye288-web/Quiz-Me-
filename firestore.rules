rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile and subcollections
    match /users/{userId} {
      // Public scholar profiles for leaderboard rankings and teacher/student display
      // Only the user themselves can create, update, or delete their profile
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Quiz history records subcollection
      match /history/{recordId} {
        allow read, write: if isOwner(userId);
      }

      // Starred/favorite presets subcollection
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }

      // User's saved/bookmarked quizzes subcollection
      match /savedQuizzes/{quizId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Shared or user-created quizzes collection
    match /quizzes/{quizId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      
      // Blue Team Hardening:
      // Prevent unauthorized modification of other users' quizzes.
      // Full edits require ownership (creator). Authenticated users interacting with community
      // quizzes (liking, commenting, saving) are strictly restricted to updating only the interaction counter fields.
      allow update: if isAuthenticated() && (
        (resource.data.creatorId == request.auth.uid && request.resource.data.creatorId == resource.data.creatorId) ||
        (request.resource.data.creatorId == resource.data.creatorId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'savesCount', 'updatedAt']))
      );
      
      allow delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;

      // Subcollection for comments: author can create and manage their own comments
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }

      // Subcollection for likes: user can only toggle their own like document
      match /likes/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Shared live quiz sessions for synchronous classroom/multiplayer assessments
    match /live_sessions/{sessionId} {
      // Any student or host can read and observe live session state
      allow read: if true;
      
      // Blue Team Hardening:
      // Validated session structure: requires roomCode and hostId matching session format
      allow create: if request.resource.data.roomCode is string && request.resource.data.hostId is string;
      
      // Updates preserve session ownership and roomCode integrity
      allow update: if request.resource.data.hostId == resource.data.hostId &&
                       request.resource.data.roomCode == resource.data.roomCode;
      
      // Only the host can terminate/delete their live session
      allow delete: if isAuthenticated() && resource.data.hostId == request.auth.uid;
    }
  }
}
