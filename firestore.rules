rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.email == "samuelezeigbo9@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isValidRole(role) {
      return role in ['Student', 'Teacher', 'Professional'];
    }

    function isValidUserCreate(userId) {
      return (!('userId' in request.resource.data) || request.resource.data.userId == userId) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
        (!('role' in request.resource.data) || isValidRole(request.resource.data.role) || isAdmin()) &&
        (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120)) &&
        (!('xp' in request.resource.data) || (request.resource.data.xp is number && request.resource.data.xp >= 0)) &&
        (!('level' in request.resource.data) || (request.resource.data.level is number && request.resource.data.level >= 1));
    }

    function isValidUserUpdate(userId) {
      return (!('userId' in request.resource.data) || request.resource.data.userId == userId) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
        (!('role' in request.resource.data) ||
          isValidRole(request.resource.data.role) ||
          (resource != null && 'role' in resource.data && request.resource.data.role == resource.data.role) ||
          isAdmin()) &&
        (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120)) &&
        (!('xp' in request.resource.data) || (request.resource.data.xp is number && request.resource.data.xp >= 0)) &&
        (!('level' in request.resource.data) || (request.resource.data.level is number && request.resource.data.level >= 1));
    }

    function isValidPublicProfile(userId) {
      return (!('userId' in request.resource.data) || request.resource.data.userId == userId) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
        (!('email' in request.resource.data)) &&
        (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120)) &&
        (!('xp' in request.resource.data) || (request.resource.data.xp is number && request.resource.data.xp >= 0)) &&
        (!('level' in request.resource.data) || (request.resource.data.level is number && request.resource.data.level >= 1));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Private User Profiles & Learning Records (Owner or Admin only)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && isValidUserCreate(userId)) || isAdmin();
      allow update: if (isOwner(userId) && isValidUserUpdate(userId)) || isAdmin();
      allow delete: if isAdmin();

      // User Quiz History Subcollection
      match /history/{recordId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) &&
          request.resource.data.quizTitle is string &&
          request.resource.data.quizTitle.size() <= 300 &&
          request.resource.data.score is number &&
          request.resource.data.total is number;
        allow delete: if isOwner(userId) || isAdmin();
      }

      // User Favorites Subcollection
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // User Saved Quizzes Subcollection
      match /savedQuizzes/{quizId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // User Following Creators Subcollection
      match /following/{creatorId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // User Adaptive Mastery & Mistake Memory Subcollection
      match /adaptive_state/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Separate Minimal Public Profiles for Community & Leaderboard Features (No PII / Email)
    match /public_profiles/{userId} {
      allow read: if true;
      allow create, update: if (isOwner(userId) && isValidPublicProfile(userId)) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Community Quizzes Collection
    match /quizzes/{quizId} {
      // Public quizzes can be read by anyone; private quizzes only by their creator or admin
      allow read: if resource.data.isPublic == true ||
                    (isAuthenticated() && resource.data.creatorId == request.auth.uid) ||
                    isAdmin();

      // Only authenticated users can create quizzes and must set themselves as creatorId
      allow create: if isAuthenticated() &&
                      request.resource.data.creatorId == request.auth.uid &&
                      request.resource.data.quiz_title is string &&
                      request.resource.data.quiz_title.size() > 0 &&
                      request.resource.data.quiz_title.size() <= 300;

      // Creators or admins can update/delete; authenticated users may only increment/decrement interaction counters by 1
      allow update: if (isAuthenticated() && resource.data.creatorId == request.auth.uid) ||
                      isAdmin() ||
                      (isAuthenticated() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'savesCount']));

      allow delete: if (isAuthenticated() && resource.data.creatorId == request.auth.uid) || isAdmin();

      // Quiz Comments Subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
                        request.resource.data.authorId == request.auth.uid &&
                        ((request.resource.data.get('content', '') is string && request.resource.data.get('content', '').size() > 0 && request.resource.data.get('content', '').size() <= 1000) ||
                         (request.resource.data.get('text', '') is string && request.resource.data.get('text', '').size() > 0 && request.resource.data.get('text', '').size() <= 1000));
        allow update, delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isAdmin();
      }

      // Quiz Likes Subcollection
      match /likes/{likeUserId} {
        allow read: if true;
        allow create, update: if isOwner(likeUserId) && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(likeUserId) || isAdmin();
      }
    }

    // Top-level Quiz Likes Tracking (legacy compatibility)
    match /quiz_likes/{likeId} {
      allow read: if true;
      allow create, update: if isAuthenticated() &&
                              request.resource.data.userId == request.auth.uid &&
                              request.resource.data.quizId is string;
      allow delete: if isAuthenticated() &&
                      (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }

    // Top-level Creator Follows Tracking (legacy compatibility)
    match /creator_follows/{followId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
                              request.resource.data.followerId == request.auth.uid &&
                              request.resource.data.creatorId is string;
      allow delete: if isAuthenticated() &&
                      (resource == null || resource.data.followerId == request.auth.uid || isAdmin());
    }

    // ===============================================================
    // School accounts
    // All writes happen on the server (Admin SDK, which bypasses these rules)
    // after an emailed code is verified. Clients may never create, edit or
    // delete any of these documents, so nobody can add themselves to a school.
    // ===============================================================

    // Registered schools: readable by their own members only.
    match /schools/{schoolId} {
      allow read: if isAuthenticated() &&
                    exists(/databases/$(database)/documents/school_members/$(request.auth.uid)) &&
                    get(/databases/$(database)/documents/school_members/$(request.auth.uid)).data.schoolId == schoolId;
      allow write: if false;
    }

    // A member's own membership record.
    match /school_members/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Internal bookkeeping (email -> account, pending codes, send quotas): server only.
    match /school_emails/{docId} {
      allow read, write: if false;
    }
    match /school_verifications/{docId} {
      allow read, write: if false;
    }
    match /school_send_log/{docId} {
      allow read, write: if false;
    }

    // Live Multiplayer Quiz Sessions (Requires authentication and host ownership validation)
    match /live_sessions/{roomCode} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                      request.resource.data.hostId == request.auth.uid &&
                      request.resource.data.roomCode == roomCode &&
                      request.resource.data.status in ['lobby', 'countdown', 'in_progress', 'question_review', 'finished'];
      allow update: if isAuthenticated() && (
                      // Host can manage session status, current question index, and participants
                      (resource.data.hostId == request.auth.uid &&
                       request.resource.data.hostId == resource.data.hostId) ||
                      // Participants can only update the participants map and updatedAt without mutating hostId, quiz, or settings
                      (request.resource.data.hostId == resource.data.hostId &&
                       request.resource.data.roomCode == resource.data.roomCode &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updatedAt'])) ||
                      isAdmin()
                    );
      allow delete: if isAuthenticated() && (resource.data.hostId == request.auth.uid || isAdmin());
    }
  }
}
